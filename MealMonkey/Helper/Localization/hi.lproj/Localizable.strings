/* AboutUs Messages */
"about_screen_title" = "हमारे बारे में";
"about_message_text1" = "हमारा मिशन एक सहज और सहज खरीदारी अनुभव प्रदान करना है जो उपयोगकर्ता संतुष्टि को प्राथमिकता देता है। हमारा लक्ष्य ऐसा प्लेटफ़ॉर्म बनाना है जहाँ ब्राउज़ करना, खरीदना और उत्पादों का प्रबंधन करना आसान और भरोसेमंद हो।";
"about_message_text2" = "हम उच्च प्रदर्शन, पारदर्शिता और विश्वास बनाए रखने के लिए प्रतिबद्ध हैं। हमारी टीम लगातार ऐप की कार्यक्षमता को बढ़ाने, डेटा गोपनीयता सुनिश्चित करने और उत्तरदायी ग्राहक सहायता प्रदान करने के लिए काम करती है।";
"about_message_text3" = "आपकी प्रतिक्रिया हमारे लिए महत्वपूर्ण है। यदि आपके कोई प्रश्न, सुझाव हैं या आपको कोई समस्या आती है, तो हम मदद के लिए हमेशा तैयार हैं। हमारी सहायता पेज से संपर्क करें या हमें सीधे ईमेल करें।";
"about_message_text4" = "हम मानते हैं कि तकनीक को लोगों की सेवा करनी चाहिए। इसलिए हम वास्तविक उपयोगकर्ता व्यवहार और आवश्यकताओं के आधार पर अपने प्लेटफ़ॉर्म को लगातार सुधारते रहते हैं।";
"about_message_text5" = "सुरक्षा हमारी प्राथमिकता है। हम आपके व्यक्तिगत डेटा की सुरक्षा के लिए उद्योग-मानक प्रोटोकॉल का उपयोग करते हैं।";
"about_message_text6" = "हम सुलभता और समावेशिता को महत्व देते हैं। हमारा प्लेटफ़ॉर्म सभी पृष्ठभूमि, उपकरणों और तकनीकी क्षमताओं के लोगों द्वारा उपयोग योग्य है।";
"about_message_text7" = "हम स्थिरता में विश्वास करते हैं। हम पर्यावरण के अनुकूल व्यावसायिक प्रथाओं का समर्थन करते हैं और ऐसे भागीदारों के साथ काम करते हैं जो हमारे मूल्यों को साझा करते हैं।";

